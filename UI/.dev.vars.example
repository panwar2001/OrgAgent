# Copy to .dev.vars for local development (`npm run dev`).
# Wrangler loads this into the Worker's env bindings.

API_BASE_URL=http://127.0.0.1:8080

# Clerk sign-in. Both keys come from https://dashboard.clerk.com (create a free app).
# Clerk ships shared Google credentials, so there is no Google Cloud console setup.
# Leave them unset to run the console without sign-in.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
